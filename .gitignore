# Visual Studio user-specific files
.vs/
.claude/
*.user

# CMake standalone build output
build/
.cache/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Epic StarterContent is bundled under UE EULA, not MPL — never commit
Content/StarterContent/

# Cooked playtest archives produced by playtest_*_cook.bat (each ~800-900 MB)
/Android.zip
/WinClient.zip
/WinServer.zip

# Throwaway build/verification logs written to the repo root by agents and by
# Build.bat runs: _build_*.log, _rev*_build_*.log, _t29rw_build_*.log and so on.
# They are per-run diagnostics, they churn on every build, and they carry no
# history worth keeping. Verified 2026-08-07: every such file in this tree is
# root-level and underscore-prefixed, and no other repo in the submodule set
# produces any.
#
# NOTE: _build_brawlertests.log, _build_editor.log, _build_server.log and
# _build_simtests.log were TRACKED before this rule. Ignoring a tracked file has
# no effect — they must be untracked once, by hand:
#     git rm --cached _build_brawlertests.log _build_editor.log \
#                     _build_server.log _build_simtests.log
# (--cached keeps them on disk.) Until that runs they will keep showing as
# modified on every build.
/_*.log